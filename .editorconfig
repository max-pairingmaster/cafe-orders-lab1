# Top-most EditorConfig file
root = true

# Всі файли
[*]
indent_style = space
indent_size = 4
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true
max_line_length = 100

# Файли C#
[*.cs]
# Форматування фігурних дужок - стиль Allman
csharp_new_line_before_open_brace = all
csharp_new_line_before_else = true
csharp_new_line_before_catch = true
csharp_new_line_before_finally = true

# Перевага обов'язкових фігурних дужок
csharp_prefer_braces = true:warning

# Правила іменування (IDE1006) - приватні поля з _camelCase
dotnet_naming_rule.private_fields_with_underscore.symbols = private_fields
dotnet_naming_rule.private_fields_with_underscore.style = prefix_underscore_camel_case
dotnet_naming_rule.private_fields_with_underscore.severity = warning

dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private, internal_and_private
dotnet_naming_symbols.private_fields.required_modifiers = 

dotnet_naming_style.prefix_underscore_camel_case.required_prefix = _
dotnet_naming_style.prefix_underscore_camel_case.capitalization = camel_case

# -------------------------------------------------------------
# Налаштування аналізаторів StyleCop (згідно з табл. Лабораторної 1)
# -------------------------------------------------------------
# SA1633: File should have header (license) -> Вимкнено
dotnet_diagnostic.SA1633.severity = none

# SA1101: Prefix local calls with this -> Вимкнено
dotnet_diagnostic.SA1101.severity = none

# SA1200: Using directive should appear within namespace -> Вимкнено
dotnet_diagnostic.SA1200.severity = none

# SA1309: Field names should not begin with an underscore -> Вимкнено (суперечить нашому _camelCase)
dotnet_diagnostic.SA1309.severity = none

# SA0001: XML comments analysis -> Вимкнено
dotnet_diagnostic.SA0001.severity = none

# SA1028: Code should not contain trailing whitespace -> Суворе попередження
dotnet_diagnostic.SA1028.severity = warning
